# SMTP (BillionMail)
SMTP_HOST=mail.tudominio.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@tudominio.com
SMTP_PASS=tu_password
SMTP_FROM=noreply@tudominio.com

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Worker
WORKER_CONCURRENCY=5

# Unsubscribe (opcional pero recomendado para envíos masivos)
# URL base SIN trailing slash — se le añade /email-settings?email=...
UNSUBSCRIBE_BASE_URL=https://tudominio.com/administracion

# Server
PORT=3000
